server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # old article links from the previous site
    rewrite ^/insights/([a-z0-9-]+?)(\.html)?$ /article-$1.html permanent;
    rewrite ^/assets/img/(.*)$ /$1 permanent;
    # old flat article URLs
    rewrite ^/(lower-payments-dont-prove-savings|cheaper-substitution-costs-more|completion-handover-readiness|progress-reports-mask-exposure|mobilization-gates|risk-management-that-changes-decisions|controlled-design-release|contracts-and-claims|schedule-recovery|receipt-review-approval-authorization)(\.html)?$ /article-$1.html permanent;

    location ~* \.(jpg|jpeg|png|svg|css|js|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
}
