server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Files are stored flat in the repository: map folder paths to the root
    location /assets/ {
        rewrite ^/assets/[a-z]+/(.*)$ /$1 break;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location /insights/ {
        rewrite ^/insights/(.*)$ /$1 last;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
}
